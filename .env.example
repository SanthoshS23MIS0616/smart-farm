# ── SmartFarm / CropAI Environment Configuration Template ───────────────────
# Rename this file to .env and fill in your actual credentials

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Twilio SMS / WhatsApp / Voice
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
FARMER_PHONE_NUMBER=+919999999999
TWILIO_VERIFY_SERVICE_SID=your_verify_sid_here

# Supabase Cloud Database (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
